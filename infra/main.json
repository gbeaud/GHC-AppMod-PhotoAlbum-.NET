                  "ingress": {
                    "external": true,
                    "targetPort": 8080,
                    "transport": "auto"
                  },
                  "registries": [
                    {
                      "server": "[parameters('registryLoginServer')]",
                      "identity": "[parameters('identityResourceId')]"
                    }
                  ]
                },
                "template": {
                  "containers": [
                    {
                      "name": "photoalbum",
                      "image": "[parameters('image')]",
                      "resources": {
                        "cpu": "[json('0.5')]",
                        "memory": "1Gi"
                      },
                      "env": [
                        {
                          "name": "ConnectionStrings__DefaultConnection",
                          "value": "[format('Server=tcp:{0},1433;Initial Catalog={1};Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;', parameters('sqlServerFqdn'), parameters('databaseName'))]"
                        },
                        {
                          "name": "AzureStorageBlob__Endpoint",
                          "value": "[parameters('storageBlobEndpoint')]"
                        },
                        {
                          "name": "AzureStorageBlob__ContainerName",
                          "value": "photos"
                        },
                        {
                          "name": "ASPNETCORE_ENVIRONMENT",
                          "value": "Production"
                        }
                      ]
                    }
                  ],
                  "scale": {
                    "minReplicas": 0,
                    "maxReplicas": 3
                  }
                }
              }
            }
          ],
          "outputs": {
            "name": {
              "type": "string",
              "value": "[parameters('name')]"
            },
            "fqdn": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('name')), '2023-05-01').configuration.ingress.fqdn]"
            }
          }
        }
      },
      "dependsOn": [
        "containerEnvironment",
        "identity",
        "registry",
        "roleAssignments",
        "sql",
        "storage"
      ]
    }
  },
  "outputs": {
    "AZURE_LOCATION": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "AZURE_RESOURCE_GROUP": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "AZURE_CONTAINER_REGISTRY_NAME": {
      "type": "string",
      "value": "[reference('registry').outputs.name.value]"
    },
    "AZURE_CONTAINER_REGISTRY_ENDPOINT": {
      "type": "string",
      "value": "[reference('registry').outputs.loginServer.value]"
    },
    "AZURE_CONTAINERAPP_NAME": {
      "type": "string",
      "value": "[reference('app').outputs.name.value]"
    },
    "AZURE_CONTAINERAPP_FQDN": {
      "type": "string",
      "value": "[reference('app').outputs.fqdn.value]"
    },
    "AZURE_CONTAINERAPP_URL": {
      "type": "string",
      "value": "[format('https://{0}', reference('app').outputs.fqdn.value)]"
    },
    "AZURE_SQL_SERVER_NAME": {
      "type": "string",
      "value": "[reference('sql').outputs.serverName.value]"
    },
    "AZURE_SQL_SERVER_FQDN": {
      "type": "string",
      "value": "[reference('sql').outputs.serverFqdn.value]"
    },
    "AZURE_SQL_DATABASE_NAME": {
      "type": "string",
      "value": "[reference('sql').outputs.databaseName.value]"
    },
    "AZURE_STORAGE_ACCOUNT_NAME": {
      "type": "string",
      "value": "[reference('storage').outputs.name.value]"
    },
    "AZURE_STORAGE_BLOB_ENDPOINT": {
      "type": "string",
      "value": "[reference('storage').outputs.blobEndpoint.value]"
    },
    "AZURE_STORAGE_CONTAINER_NAME": {
      "type": "string",
      "value": "[reference('storage').outputs.containerName.value]"
    },
    "USER_ASSIGNED_IDENTITY_NAME": {
      "type": "string",
      "value": "[reference('identity').outputs.name.value]"
    },
    "USER_ASSIGNED_IDENTITY_CLIENT_ID": {
      "type": "string",
      "value": "[reference('identity').outputs.clientId.value]"
    },
    "USER_ASSIGNED_IDENTITY_PRINCIPAL_ID": {
      "type": "string",
      "value": "[reference('identity').outputs.principalId.value]"
    },
    "LOG_ANALYTICS_WORKSPACE_NAME": {
      "type": "string",
      "value": "[reference('logs').outputs.name.value]"
    },
    "LOG_ANALYTICS_WORKSPACE_ID": {
      "type": "string",
      "value": "[reference('logs').outputs.customerId.value]"
    }
  }
}