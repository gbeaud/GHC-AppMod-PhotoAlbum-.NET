{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "5251371063207372097"
    },
    "description": "Provisions Azure resources for PhotoAlbum web application with Container Apps, SQL Database, and Blob Storage.",
    "name": "PhotoAlbum Cloud Infrastructure",
    "version": "1.0.0"
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "metadata": {
        "description": "Name of the environment (e.g., dev, test, prod)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Primary location for all resources"
      }
    },
    "webImageName": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest",
      "metadata": {
        "description": "Container image name for the web service (set by azd deploy)"
      }
    },
    "sqlAdminUsername": {
      "type": "string",
      "defaultValue": "sqladmin",
      "minLength": 1,
      "maxLength": 128,
      "metadata": {
        "description": "SQL Server admin username"
      }
    },
    "sqlAdminPassword": {
      "type": "securestring",
      "minLength": 8,
      "maxLength": 128,
      "metadata": {
        "description": "SQL Server admin password"
      }
    }
  },
  "variables": {
    "resourceToken": "[toLower(uniqueString(subscription().id, resourceGroup().id, parameters('location'), parameters('environmentName')))]",
    "tags": {
      "azd-env-name": "[parameters('environmentName')]",
      "SecurityControl": "Ignore"
    },
    "sqlServerName": "[format('azsql{0}', variables('resourceToken'))]",
    "sqlServerFqdn": "[format('{0}{1}', variables('sqlServerName'), environment().suffixes.sqlServerHostname)]",
    "sqlConnectionString": "[format('Server=tcp:{0},1433;Initial Catalog=PhotoAlbumDb;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;', variables('sqlServerFqdn'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('azuai{0}', variables('resourceToken'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[format('azlog{0}', variables('resourceToken'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2023-05-01",
      "name": "[format('azaca{0}', variables('resourceToken'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('azlog{0}', variables('resourceToken'))), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('azlog{0}', variables('resourceToken'))), '2022-10-01').primarySharedKey]"
          }
        },
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ]
      },
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('azlog{0}', variables('resourceToken')))]"
      ]
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[format('azacr{0}', variables('resourceToken'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Enabled"
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', variables('resourceToken')))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', variables('resourceToken'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), 'AcrPull')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', variables('resourceToken')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken')))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2021-11-01",
      "name": "[variables('sqlServerName')]",
      "location": "eastus2",
      "properties": {
        "administratorLogin": "[parameters('sqlAdminUsername')]",
        "administratorLoginPassword": "[parameters('sqlAdminPassword')]",
        "version": "12.0",
        "publicNetworkAccess": "Enabled",
        "restrictOutboundNetworkAccess": "Disabled"
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Sql/servers/azureADOnlyAuthentications",
      "apiVersion": "2021-11-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'Default')]",
      "properties": {
        "azureADOnlyAuthentication": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/administrators",
      "apiVersion": "2021-11-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'ActiveDirectory')]",
      "properties": {
        "administratorType": "ActiveDirectory",
        "login": "PhotoAlbum-admin",
        "sid": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), '2023-01-31').principalId]",
        "tenantId": "[tenant().tenantId]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]",
        "[resourceId('Microsoft.Sql/servers/azureADOnlyAuthentications', variables('sqlServerName'), 'Default')]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken')))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2021-11-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'PhotoAlbumDb')]",
      "location": "eastus2",
      "sku": {
        "name": "Basic",
        "tier": "Basic"
      },
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 2147483648
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2021-11-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2021-11-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'AllowPublicAccess')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "255.255.255.255"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), 'PhotoAlbumDb')]",
      "name": "[guid(resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), 'PhotoAlbumDb'), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), 'SQLDbContributor')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '9b7fa17d-e63a-4465-a4fd-dd924db0604b')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), 'PhotoAlbumDb')]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken')))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[format('azsto{0}', replace(variables('resourceToken'), '-', ''))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "defaultToOAuthAuthentication": true,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}', format('azsto{0}', replace(variables('resourceToken'), '-', '')), 'default')]",
      "properties": {
        "cors": {
          "corsRules": [
            {
              "allowedHeaders": [
                "*"
              ],
              "allowedMethods": [
                "GET",
                "HEAD",
                "PUT",
                "POST",
                "DELETE",
                "OPTIONS"
              ],
              "allowedOrigins": [
                "*"
              ],
              "exposedHeaders": [
                "*"
              ],
              "maxAgeInSeconds": 3600
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', format('azsto{0}', replace(variables('resourceToken'), '-', '')))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}/{2}', format('azsto{0}', replace(variables('resourceToken'), '-', '')), 'default', 'photos')]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', format('azsto{0}', replace(variables('resourceToken'), '-', '')), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', format('azsto{0}', replace(variables('resourceToken'), '-', '')))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', format('azsto{0}', replace(variables('resourceToken'), '-', ''))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), 'StorageBlobDataContributor')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', format('azsto{0}', replace(variables('resourceToken'), '-', '')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[format('azaca{0}', variables('resourceToken'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('azaca{0}', variables('resourceToken')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "corsPolicy": {
              "allowedOrigins": [
                "*"
              ],
              "allowedMethods": [
                "*"
              ],
              "allowedHeaders": [
                "*"
              ]
            }
          },
          "registries": "[if(contains(parameters('webImageName'), reference(resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', variables('resourceToken'))), '2023-07-01').loginServer), createArray(createObject('server', reference(resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', variables('resourceToken'))), '2023-07-01').loginServer, 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))))), createArray())]",
          "secrets": []
        },
        "template": {
          "containers": [
            {
              "name": "photoalbum",
              "image": "[parameters('webImageName')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "ConnectionStrings__DefaultConnection",
                  "value": "[variables('sqlConnectionString')]"
                },
                {
                  "name": "AzureStorageBlob__Endpoint",
                  "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', format('azsto{0}', replace(variables('resourceToken'), '-', ''))), '2023-01-01').primaryEndpoints.blob]"
                },
                {
                  "name": "AzureStorageBlob__ContainerName",
                  "value": "photos"
                },
                {
                  "name": "ASPNETCORE_ENVIRONMENT",
                  "value": "Production"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3
          }
        }
      },
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', variables('resourceToken'))), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', variables('resourceToken'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), 'AcrPull'))]",
        "[resourceId('Microsoft.App/managedEnvironments', format('azaca{0}', variables('resourceToken')))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', variables('resourceToken')))]",
        "[extensionResourceId(resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), 'PhotoAlbumDb'), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), 'PhotoAlbumDb'), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), 'SQLDbContributor'))]",
        "[resourceId('Microsoft.Sql/servers/azureADOnlyAuthentications', variables('sqlServerName'), 'Default')]",
        "[resourceId('Microsoft.Storage/storageAccounts', format('azsto{0}', replace(variables('resourceToken'), '-', '')))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', format('azsto{0}', replace(variables('resourceToken'), '-', ''))), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', format('azsto{0}', replace(variables('resourceToken'), '-', ''))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), 'StorageBlobDataContributor'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken')))]"
      ]
    }
  ],
  "outputs": {
    "AZURE_LOCATION": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "AZURE_RESOURCE_GROUP": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "AZURE_CONTAINER_REGISTRY_ENDPOINT": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', variables('resourceToken'))), '2023-07-01').loginServer]"
    },
    "AZURE_CONTAINER_REGISTRY_NAME": {
      "type": "string",
      "value": "[format('azacr{0}', variables('resourceToken'))]"
    },
    "AZURE_CONTAINERAPP_NAME": {
      "type": "string",
      "value": "[format('azaca{0}', variables('resourceToken'))]"
    },
    "AZURE_CONTAINERAPP_FQDN": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', format('azaca{0}', variables('resourceToken'))), '2023-05-01').configuration.ingress.fqdn]"
    },
    "AZURE_CONTAINERAPP_URL": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('azaca{0}', variables('resourceToken'))), '2023-05-01').configuration.ingress.fqdn)]"
    },
    "AZURE_SQL_SERVER_NAME": {
      "type": "string",
      "value": "[variables('sqlServerName')]"
    },
    "AZURE_SQL_SERVER_FQDN": {
      "type": "string",
      "value": "[variables('sqlServerFqdn')]"
    },
    "AZURE_SQL_DATABASE_NAME": {
      "type": "string",
      "value": "PhotoAlbumDb"
    },
    "AZURE_STORAGE_ACCOUNT_NAME": {
      "type": "string",
      "value": "[format('azsto{0}', replace(variables('resourceToken'), '-', ''))]"
    },
    "AZURE_STORAGE_BLOB_ENDPOINT": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', format('azsto{0}', replace(variables('resourceToken'), '-', ''))), '2023-01-01').primaryEndpoints.blob]"
    },
    "USER_ASSIGNED_IDENTITY_ID": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken')))]"
    },
    "USER_ASSIGNED_IDENTITY_PRINCIPAL_ID": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azuai{0}', variables('resourceToken'))), '2023-01-31').principalId]"
    }
  }
}